# Runtime Mode ('production' on Railway, 'development' locally)
NODE_ENV=production

# HTTP Server Port (Railway sets PORT automatically; default 3000 locally)
PORT=3000

# JSON Web Token Secret (Replace with a strong random secret in Railway Variables)
JWT_SECRET=replace-with-a-64-char-random-secret-key

# SQLite Database Path (On Railway with a Volume mounted at /data, use /data/quran_mate.sqlite)
SQLITE_PATH=/data/quran_mate.sqlite

# Optional Gemini API Key (Server-side only for AI Qur'an Reflection Card image generation)
GEMINI_API_KEY=
